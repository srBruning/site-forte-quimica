---
import '../styles.css';

const {
  title = 'Forte Química Polibom | Produtos de limpeza no bairro Kaiser',
  description = 'Produtos de limpeza de alta performance com qualidade e economia. Visite a Forte Química Polibom na Rua Ernesto Casara, 945, bairro Kaiser.',
  pageType = 'website',
  structuredData
} = Astro.props;
const base = import.meta.env.BASE_URL;
const siteRoot = Astro.site ? new URL(base, Astro.site).href.replace(/\/$/, '') : undefined;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL(`${base}images/compartilhamento-forte-quimica.jpg`, Astro.site).href : undefined;
const logo = Astro.site ? new URL(`${base}images/logo-forte-quimica.png`, Astro.site).href : undefined;
const business = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: 'Forte Química Polibom',
  description: 'Produtos de limpeza de alta performance. Qualidade, economia e eficiência.',
  ...(canonical ? { url: canonical } : {}),
  ...(logo ? { image: logo, logo } : {}),
  address: { '@type': 'PostalAddress', streetAddress: 'Rua Ernesto Casara, 945, bairro Kaiser', addressCountry: 'BR' },
  telephone: '+55 54 99630-6905',
  geo: { '@type': 'GeoCoordinates', latitude: -29.18973300313056, longitude: -51.19656257274597 },
  hasMap: 'https://share.google/bs95eL0bHxtmfuZDo',
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'], opens: '08:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:00', closes: '12:00' }
  ],
  sameAs: ['https://www.instagram.com/fortequimicapolibom/']
};
const website = siteRoot ? {
  '@context': 'https://schema.org', '@type': 'WebSite', name: 'Forte Química Polibom', url: siteRoot
} : undefined;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#082c50" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} sizes="64x64" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Forte Química Polibom" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content="Forte Química Polibom — O barato da limpeza" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content="Forte Química Polibom — O barato da limpeza" />}
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {website && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body><slot /></body>
</html>
