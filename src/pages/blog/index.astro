---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Blog de limpeza | Forte Química Polibom" description="Dicas de organização, cuidados e planejamento para uma rotina de limpeza mais prática. Leia o blog da Forte Química Polibom.">
<header class="bg-white shadow-sm"><nav aria-label="Navegação principal" class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-3 lg:px-8"><a href={base} aria-label="Forte Química Polibom, início"><img src={`${base}images/logo-forte-quimica.png`} alt="Forte Química Polibom" width="160" height="132" class="h-18 w-auto object-contain"/></a><div class="flex items-center gap-5 font-semibold text-[#123a63]"><a href={base} class="hover:text-[#38a91e]">Início</a><a href={`${base}blog/`} aria-current="page" class="text-[#38a91e]">Blog</a><a href={`${base}#contato`} class="hidden hover:text-[#38a91e] sm:inline">Contato</a></div></nav></header>
<main><section class="bg-gradient-to-br from-[#e9f8ff] via-white to-[#effbea] px-5 py-20 lg:px-8"><div class="mx-auto max-w-7xl"><p class="text-sm font-bold uppercase tracking-[.2em] text-[#36a421]">Forte Química Polibom</p><h1 class="mt-4 text-5xl font-extrabold tracking-tight text-[#082c50]">Blog de limpeza</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-[#50667a]">Ideias simples para cuidar dos ambientes, organizar a rotina e usar produtos de limpeza com atenção.</p></div></section><section class="bg-white px-5 py-20 lg:px-8"><div class="mx-auto grid max-w-7xl gap-6 md:grid-cols-2 lg:grid-cols-3">{posts.map(post => <article class="flex flex-col rounded-3xl border border-[#dceef5] bg-[#f7fcff] p-7 shadow-sm"><p class="text-sm font-bold uppercase tracking-wider text-[#36a421]">{post.category}</p><h2 class="mt-4 text-2xl font-extrabold leading-tight text-[#082c50]"><a href={`${base}blog/${post.slug}/`} class="hover:text-[#259a2a]">{post.title}</a></h2><p class="mt-4 flex-1 leading-7 text-[#50667a]">{post.description}</p><p class="mt-6 text-sm text-[#64798c]">{post.readingTime}</p><a href={`${base}blog/${post.slug}/`} class="mt-4 font-bold text-[#0b61ae] hover:text-[#36a421]" aria-label={`Ler artigo: ${post.title}`}>Ler artigo →</a></article>)}</div></section></main>
<footer class="bg-[#06233f] px-5 py-8 text-center text-sm text-white/65">© {new Date().getFullYear()} Forte Química Polibom. <a href={base} class="ml-2 text-white hover:underline">Voltar ao início</a></footer>
</BaseLayout>
