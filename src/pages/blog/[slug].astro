---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';
export function getStaticPaths() { return posts.map(post => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteRoot = Astro.site ? new URL(base, Astro.site).href.replace(/\/$/, '') : undefined;
const articleData = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, description: post.description, author: { '@type': 'Organization', name: 'Forte Química Polibom' }, publisher: { '@type': 'Organization', name: 'Forte Química Polibom' }, ...(siteRoot ? { mainEntityOfPage: `${siteRoot}/blog/${post.slug}/` } : {}) };
---
<BaseLayout title={`${post.title} | Forte Química Polibom`} description={post.description} pageType="article" structuredData={articleData}>
<header class="bg-white shadow-sm"><nav aria-label="Navegação principal" class="mx-auto flex max-w-5xl items-center justify-between gap-5 px-5 py-3"><a href={base} aria-label="Forte Química Polibom, início"><img src={`${base}images/logo-forte-quimica.png`} alt="Forte Química Polibom" width="160" height="132" class="h-18 w-auto object-contain"/></a><a href={`${base}blog/`} class="font-bold text-[#0b61ae] hover:text-[#36a421]">← Voltar ao blog</a></nav></header>
<main><article class="mx-auto max-w-3xl px-5 py-16"><p class="text-sm font-bold uppercase tracking-[.2em] text-[#36a421]">{post.category} <span class="mx-2 text-[#aac5d4]">•</span> {post.readingTime}</p><h1 class="mt-5 text-4xl font-extrabold leading-tight text-[#082c50] sm:text-5xl">{post.title}</h1><p class="mt-6 border-b border-[#dceef5] pb-8 text-xl leading-8 text-[#50667a]">{post.description}</p><div class="space-y-10 py-8">{post.sections.map(section => <section><h2 class="text-2xl font-extrabold text-[#0b3d7b]">{section.heading}</h2>{section.paragraphs.map(paragraph => <p class="mt-4 text-lg leading-8 text-[#435b70]">{paragraph}</p>)}{section.heading === 'Tabela de misturas domésticas perigosas' && post.mixtures && <div class="mt-6 overflow-x-auto rounded-2xl border border-[#dceef5]"><table class="w-full min-w-[680px] border-collapse text-left"><caption class="sr-only">Combinações de produtos de limpeza que não devem ser feitas</caption><thead class="bg-[#082c50] text-white"><tr><th scope="col" class="p-4">Combinação</th><th scope="col" class="p-4">O que pode acontecer</th><th scope="col" class="p-4">Risco à saúde</th></tr></thead><tbody>{post.mixtures.map((item, index) => <tr class={index % 2 === 0 ? 'bg-[#f0f8fc]' : 'bg-white'}><th scope="row" class="p-4 align-top font-bold text-[#082c50]">{item.combination}</th><td class="p-4 align-top text-[#435b70]">{item.whatHappens}</td><td class="p-4 align-top text-[#435b70]">{item.risk}</td></tr>)}</tbody></table></div>}</section>)}</div>{post.sources && <aside class="border-t border-[#dceef5] pt-8"><h2 class="text-xl font-extrabold text-[#082c50]">Fontes consultadas</h2><ul class="mt-4 space-y-2">{post.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer" class="text-[#0b61ae] underline hover:text-[#36a421]">{source.label}</a></li>)}</ul></aside>}<div class="mt-10 rounded-3xl bg-[#eef8fc] p-7"><p class="font-bold text-[#082c50]">Conheça a Forte Química Polibom</p><p class="mt-2 leading-7 text-[#50667a]">Visite a loja na Rua Ernesto Casara, 945, bairro Kaiser, ou fale com a gente.</p><a href={`${base}#contato`} class="mt-4 inline-block font-bold text-[#0b61ae] hover:text-[#36a421]">Ver contato →</a></div></article></main>
<footer class="bg-[#06233f] px-5 py-8 text-center text-sm text-white/65">© {new Date().getFullYear()} Forte Química Polibom. <a href={`${base}blog/`} class="ml-2 text-white hover:underline">Mais artigos</a></footer>
</BaseLayout>
